# Sao chép thành .env.local và điền giá trị thật. Không commit .env.local.

# Chuỗi kết nối PostgreSQL của Supabase (dùng connection pooler cho Vercel)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase (đăng nhập quản trị, lưu tệp)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Địa chỉ gốc của trang công khai, dùng để sinh QR trang lô
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mã khởi tạo tài khoản chủ cửa hàng (bắt buộc ở bản chạy thật, ít nhất 24 ký tự ngẫu nhiên).
# Khi DB chưa có nhân viên, /dang-nhap hiện form tạo chủ cửa hàng và đòi nhập đúng mã này.
# Thiếu hoặc ngắn hơn 24 ký tự: bản chạy thật KHÔNG cho tạo chủ (trang báo "Chưa bật khởi tạo").
# Tạo mã: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Tạo xong chủ cửa hàng thì XÓA biến này khỏi Vercel và deploy lại.
# Chạy thử trên máy (npm run dev) không cần mã.
SETUP_TOKEN=

# Phiên bản chính sách dữ liệu đang áp dụng (POM-88)
CONSENT_POLICY_VERSION=2026-11-v1

# Email nhận cảnh báo (ngưỡng phản ánh, lỗi tác vụ)
ALERT_EMAIL=

# Thông báo cho chủ cửa hàng (đơn mới, phản ánh). Người nhận điền trong /admin/cai-dat.
# Email qua Resend (resend.com). Chưa có tên miền thì bỏ trống NOTIFY_EMAIL_FROM.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
# Zalo Official Account: app ở developers.zalo.me liên kết với OA. Refresh token dùng một lần,
# hệ thống tự lưu token mới vào bảng settings (khóa zalo_oa_token) sau lần làm mới đầu tiên.
ZALO_OA_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_REFRESH_TOKEN=

# Chỉ dùng khi chạy thử bằng PGlite (không có DATABASE_URL). Mặc định nạp dữ liệu mẫu (đang bán,
# bật nhận đơn). Đặt production để thử với đúng dữ liệu của bản chạy thật (tắt bán, tồn kho 0).
# Đổi giá trị thì xóa thư mục .data/ trước. Không đặt biến này trên bản chạy thật.
# PGLITE_SEED=production
